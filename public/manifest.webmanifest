{
  "name": "ContactKickstart",
  "short_name": "ContactKickstart",
  "description": "Digital business cards: share by QR, capture every contact you meet, and send follow-ups that get replies.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FAF8F5",
  "theme_color": "#E8553D",
  "icons": [
    { "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/brand/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/brand/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "My QR code",
      "short_name": "My QR",
      "description": "Show your card's QR code, ready to scan",
      "url": "/app/qr",
      "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Scan a card",
      "short_name": "Scan",
      "description": "Scan a paper business card into your contacts",
      "url": "/app/scan",
      "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
